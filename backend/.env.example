# ═══════════════════════════════════════════════════════════════
# TESLA COTIZADOR V3.0 - CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════
# Copia este archivo a .env y configura tus API keys

# ═══════════════════════════════════════════════════════════════
# 🤖 PILI ULTRA INTELIGENTE - MULTI-IA CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# PILI ahora es un agente inteligente con LangChain + LiteLLM
# Soporta múltiples IAs con fallback automático
#
# DESARROLLO: Usa IAs GRATUITAS (Gemini, Groq, Together AI)
# PRODUCCIÓN: Cambia a IAs de pago (OpenAI, Claude) solo cambiando .env

# ──────────────────────────────────────────────────────────────
# CONFIGURACIÓN MULTI-IA (LiteLLM Router)
# ──────────────────────────────────────────────────────────────
# Modelo primario (el que se intenta primero)
PRIMARY_MODEL=gemini/gemini-1.5-pro

# Modelos de fallback (separados por coma)
# Se intentan en orden si el primario falla
FALLBACK_MODELS=groq/llama-3.1-70b-versatile,together_ai/meta-llama/Llama-3-70b-chat-hf

# ──────────────────────────────────────────────────────────────
# OPCIÓN 1: Google Gemini (RECOMENDADO - GRATIS + Excelente)
# ──────────────────────────────────────────────────────────────
# Obtén tu key gratis en: https://makersuite.google.com/app/apikey
# Límite gratuito: 60 requests/minuto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
TEMPERATURE=0.3
MAX_TOKENS=4000

# ──────────────────────────────────────────────────────────────
# OPCIÓN 2: OpenAI ChatGPT-4 (Más caro pero muy bueno)
# ──────────────────────────────────────────────────────────────
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────
# OPCIÓN 3: Anthropic Claude 3 (Excelente para análisis)
# ──────────────────────────────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────
# OPCIÓN 4: Groq Llama 3.1 (GRATIS - ULTRA RÁPIDO)
# ──────────────────────────────────────────────────────────────
# Obtén tu key gratis en: https://console.groq.com/
# Límite gratuito: 30 requests/minuto
# Ventaja: Respuestas en < 1 segundo (muy rápido)
GROQ_API_KEY=

# ──────────────────────────────────────────────────────────────
# OPCIÓN 5: Together AI (GRATIS - Modelos open source)
# ──────────────────────────────────────────────────────────────
# Obtén tu key gratis en: https://api.together.xyz/
# Límite gratuito: 60 requests/minuto
# Ventaja: Varios modelos Llama, Mixtral disponibles
TOGETHER_API_KEY=

# ──────────────────────────────────────────────────────────────
# OPCIÓN 6: Cohere (GRATIS - Buen NLP)
# ──────────────────────────────────────────────────────────────
# Obtén tu key gratis en: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ═══════════════════════════════════════════════════════════════
# 🗄️ BASE DE DATOS
# ═══════════════════════════════════════════════════════════════
# En desarrollo usa SQLite (automático)
# En producción configura PostgreSQL

ENVIRONMENT=development
# ENVIRONMENT=production

# PostgreSQL (solo para producción)
# PROD_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/tesla_db

# ═══════════════════════════════════════════════════════════════
# 🔒 SEGURIDAD
# ═══════════════════════════════════════════════════════════════
SECRET_KEY=cambia-esto-en-produccion-por-algo-muy-seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════════════
# 🌐 SERVIDOR
# ═══════════════════════════════════════════════════════════════
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# 📁 ARCHIVOS
# ═══════════════════════════════════════════════════════════════
ALLOWED_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg
MAX_UPLOAD_SIZE_MB=10

# ═══════════════════════════════════════════════════════════════
# 🎚️ FEATURE FLAGS (ON/OFF)
# ═══════════════════════════════════════════════════════════════
# Cambia a "True" para habilitar funcionalidades avanzadas
# Por defecto TODO está en OFF (modo desarrollo)

# Sistema de tokens (límites por plan)
FEATURE_TOKEN_MANAGER=False

# Multi-IA Orchestrator (Gemini + Claude + GPT-4)
FEATURE_MULTI_IA=False

# Sistema Multi-Agente (3 agentes colaborando)
FEATURE_MULTI_AGENT=False

# Autenticación de usuarios
FEATURE_AUTH_USUARIOS=False

# Rate limiting (límite de requests/minuto)
FEATURE_RATE_LIMIT=False

# Dashboard de analytics
FEATURE_ANALYTICS=False

# ═══════════════════════════════════════════════════════════════
# 🐛 DEBUG
# ═══════════════════════════════════════════════════════════════
DEBUG=True
LOG_LEVEL=INFO
